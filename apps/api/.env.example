# Copy to .env and fill in local values. .env is git-ignored.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/ride_booking

# Optional — separate database used by integration tests (it is wiped between tests)
TEST_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/ride_booking_test

PORT=4000
LOG_LEVEL=info
# Comma-separated list of origins allowed to call the API (the web app)
CORS_ORIGIN=http://localhost:3000
